{
  "name": "pagepilot",
  "version": "0.1.0",
  "private": true,
  "description": "网页自动操作 + AI 集成工具（Web 控制台 + 浏览器扩展 + AI 代理）",
  "author": "PagePilot",
  "main": "desktop/main.js",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm run start -w server",
    "desktop": "electron desktop/main.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "pack:portable": "electron-builder --win --dir --config.directories.output=release/portable",
    "pack:installer": "electron-builder --win nsis --config.directories.output=release/installer",
    "pack": "npm run pack:portable && npm run pack:installer"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pagepilot.app",
    "productName": "PagePilot",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/dist/**/*",
      "server/package.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PagePilot-Setup-${version}.${ext}"
    }
  }
}
